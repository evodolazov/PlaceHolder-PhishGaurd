{
  "manifest_version": 3,
  "name": "PhishGuard Scanner",
  "description": "Manually scan the active tab URL with a configured PhishGuard backend.",
  "version": "0.1.0",
  "permissions": ["activeTab", "storage"],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Scan with PhishGuard",
    "default_popup": "popup.html"
  }
}
